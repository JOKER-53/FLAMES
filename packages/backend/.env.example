PORT=4000

# Optional: leave blank to use grading without the AI tutor.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=
NVIDIA_NIM_MODEL=

FRONTEND_ORIGIN=http://localhost:5173
AUTH_REQUIRED=false
ALLOW_REGISTRATION=true
# Node 22.13+ is required; database defaults to data/fortisim.sqlite.
# DATABASE_PATH=/absolute/path/to/fortisim.sqlite
# Optional first-start instructor account. Set both fields together.
INSTRUCTOR_EMAIL=
INSTRUCTOR_PASSWORD=

# Optional parent-managed Academy integration (standalone is the default).
PLATFORM_MODE=standalone
# Required only when PLATFORM_MODE=academy:
# ACADEMY_ORIGIN=http://110.172.151.108:5173
# ACADEMY_API_URL=http://110.172.151.108:4000/api

# Optional: persistent module/lesson/task drafts and published snapshots.
# CONTENT_DATABASE_PATH=/absolute/path/to/content.sqlite
